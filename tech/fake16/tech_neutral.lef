VERSION 5.8 ;
NAMESCASESENSITIVE ON ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
UNITS
  DATABASE MICRONS 1000 ;
END UNITS

-- Layer definitions (adjust according to your PDK)
LAYER M1
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 0.064 ;
  WIDTH 0.032 ;
  SPACING 0.032 ;
  OFFSET 0.032 ;
END M1

LAYER M2
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.064 ;
  WIDTH 0.032 ;
  SPACING 0.032 ;
  OFFSET 0.032 ;
END M2

LAYER VIA1
  TYPE CUT ;
  PITCH 0.064 0.064 ;
  WIDTH 0.032 ;
  SPACING 0.032 ;
END VIA1

-- Macro for nor2 with power rails and MY symmetry
MACRO nor2
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.5 BY 0.12 ;
  SYMMETRY MY ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.03 0.05 0.06 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.45 0.03 0.5 0.06 ;
    END
  END B
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M1 ;
      RECT 0.225 0.09 0.275 0.12 ;
    END
  END Y
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.117 0.5 0.12 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER M1 ;
      RECT 0.0 0.0 0.5 0.003 ;
    END
  END VSS
  OBS
    LAYER M1 ;
    RECT 0.05 0.003 0.45 0.03 ;
    RECT 0.05 0.06 0.45 0.117 ;
  END
END nor2

