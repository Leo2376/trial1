-- Macro for inv with power rails and MY symmetry
MACRO inv
  CLASS CORE ;
  ORIGIN 0.0 0.0 ;
  SIZE 0.387 BY 0.12 ;
  SYMMETRY MY ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
