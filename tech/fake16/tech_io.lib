library(io_pads_16nm) {
  /* Header */
  delay_model : "table_lookup";
  time_unit : "1ps";
  voltage_unit : "1V";
  current_unit : "1uA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1pW";
  temperature : 25.0;

  /* Default operating conditions */
  default_operating_conditions : "tt_0p8v_25c";

  /* Lookup table template for IO timing */
  lu_table_template("io_template_5x5") {
    variable_1 : "input_net_transition";
    variable_2 : "total_output_net_capacitance";
    index_1 ("50, 100, 200, 400, 800");
    index_2 ("0.005, 0.01, 0.02, 0.05, 0.1");
  }

  /* Operating conditions */
  operating_conditions("tt_0p8v_25c") {
    process : 1.0;
    voltage : 0.8;
    temperature : 25.0;
  }

  /* Bidirectional Pad (Horizontal) */
  cell(bidir_pad_h) {
    area : 100.0;  /* Placeholder: Replace with actual area */
    pad_cell : true;
    direction : inout;

    /* Pad input pin */
    pin(pad) {
      direction : inout;
      capacitance : 0.5;
      max_capacitance : 5.0;
      min_capacitance : 0.01;
      input_voltage : "PAD";
      output_voltage : "PAD";
      three_state : "enable";
      timing() {
        related_pin : "enable";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("100, 120, 150, 200, 250",
                 "120, 140, 170, 220, 270",
                 "150, 170, 200, 250, 300",
                 "200, 220, 250, 300, 350",
                 "250, 270, 300, 350, 400");
        }
        cell_fall(io_template_5x5) {
          values("110, 130, 160, 210, 260",
                 "130, 150, 180, 230, 280",
                 "160, 180, 210, 260, 310",
                 "210, 230, 260, 310, 360",
                 "260, 280, 310, 360, 410");
        }
        rise_transition(io_template_5x5) {
          values("50, 60, 80, 120, 160",
                 "60, 70, 90, 130, 170",
                 "80, 90, 110, 150, 190",
                 "120, 130, 150, 190, 230",
                 "160, 170, 190, 230, 270");
        }
        fall_transition(io_template_5x5) {
          values("55, 65, 85, 125, 165",
                 "65, 75, 95, 135, 175",
                 "85, 95, 115, 155, 195",
                 "125, 135, 155, 195, 235",
                 "165, 175, 195, 235, 275");
        }
      }
    }

    /* Enable pin */
    pin(enable) {
      direction : input;
      capacitance : 0.05;
      timing() {
        related_pin : "pad";
        timing_type : hold_rising;
        hold(io_template_5x5) {
          values("10, 15, 20, 25, 30",
                 "15, 20, 25, 30, 35",
                 "20, 25, 30, 35, 40",
                 "25, 30, 35, 40, 45",
                 "30, 35, 40, 45, 50");
        }
      }
    }

    /* Core-side input pin */
    pin(core_in) {
      direction : input;
      capacitance : 0.02;
      related_power_pin : "VDD";
      timing() {
        related_pin : "pad";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("50, 60, 80, 120, 160",
                 "60, 70, 90, 130, 170",
                 "80, 90, 110, 150, 190",
                 "120, 130, 150, 190, 230",
                 "160, 170, 190, 230, 270");
        }
        cell_fall(io_template_5x5) {
          values("55, 65, 85, 125, 165",
                 "65, 75, 95, 135, 175",
                 "85, 95, 115, 155, 195",
                 "125, 135, 155, 195, 235",
                 "165, 175, 195, 235, 275");
        }
      }
    }

    /* Core-side output pin */
    pin(core_out) {
      direction : output;
      capacitance : 0.02;
      function : "enable ? core_out : 1'bz";
      timing() {
        related_pin : "pad";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("60, 70, 90, 130, 170",
                 "70, 80, 100, 140, 180",
                 "90, 100, 120, 160, 200",
                 "130, 140, 160, 200, 240",
                 "170, 180, 200, 240, 280");
        }
        cell_fall(io_template_5x5) {
          values("65, 75, 95, 135, 175",
                 "75, 85, 105, 145, 185",
                 "95, 105, 125, 165, 205",
                 "135, 145, 165, 205, 245",
                 "175, 185, 205, 245, 285");
        }
      }
    }

    /* Power pins */
    pin(VDD) {
      direction : inout;
      use : power;
      voltage_name : "CORE";
    }
    pin(VSS) {
      direction : inout;
      use : ground;
      voltage_name : "CORE";
    }

    /* Power consumption */
    cell_leakage_power : 10.0;
    internal_power() {
      related_pin : "pad";
      rise_power(io_template_5x5) {
        values("0.1, 0.12, 0.15, 0.2, 0.25",
               "0.12, 0.14, 0.17, 0.22, 0.27",
               "0.15, 0.17, 0.2, 0.25, 0.3",
               "0.2, 0.22, 0.25, 0.3, 0.35",
               "0.25, 0.27, 0.3, 0.35, 0.4");
      }
      fall_power(io_template_5x5) {
        values("0.11, 0.13, 0.16, 0.21, 0.26",
               "0.13, 0.15, 0.18, 0.23, 0.28",
               "0.16, 0.18, 0.21, 0.26, 0.31",
               "0.21, 0.23, 0.26, 0.31, 0.36",
               "0.26, 0.28, 0.31, 0.36, 0.41");
      }
    }
  }

  /* Bidirectional Pad (Vertical) */
  cell(bidir_pad_v) {
    area : 100.0;  /* Placeholder: Replace with actual area */
    pad_cell : true;
    direction : inout;

    /* Pad input pin */
    pin(pad) {
      direction : inout;
      capacitance : 0.5;
      max_capacitance : 5.0;
      min_capacitance : 0.01;
      input_voltage : "PAD";
      output_voltage : "PAD";
      three_state : "enable";
      timing() {
        related_pin : "enable";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("100, 120, 150, 200, 250",
                 "120, 140, 170, 220, 270",
                 "150, 170, 200, 250, 300",
                 "200, 220, 250, 300, 350",
                 "250, 270, 300, 350, 400");
        }
        cell_fall(io_template_5x5) {
          values("110, 130, 160, 210, 260",
                 "130, 150, 180, 230, 280",
                 "160, 180, 210, 260, 310",
                 "210, 230, 260, 310, 360",
                 "260, 280, 310, 360, 410");
        }
        rise_transition(io_template_5x5) {
          values("50, 60, 80, 120, 160",
                 "60, 70, 90, 130, 170",
                 "80, 90, 110, 150, 190",
                 "120, 130, 150, 190, 230",
                 "160, 170, 190, 230, 270");
        }
        fall_transition(io_template_5x5) {
          values("55, 65, 85, 125, 165",
                 "65, 75, 95, 135, 175",
                 "85, 95, 115, 155, 195",
                 "125, 135, 155, 195, 235",
                 "165, 175, 195, 235, 275");
        }
      }
    }

    /* Enable pin */
    pin(enable) {
      direction : input;
      capacitance : 0.05;
      timing() {
        related_pin : "pad";
        timing_type : hold_rising;
        hold(io_template_5x5) {
          values("10, 15, 20, 25, 30",
                 "15, 20, 25, 30, 35",
                 "20, 25, 30, 35, 40",
                 "25, 30, 35, 40, 45",
                 "30, 35, 40, 45, 50");
        }
      }
    }

    /* Core-side input pin */
    pin(core_in) {
      direction : input;
      capacitance : 0.02;
      related_power_pin : "VDD";
      timing() {
        related_pin : "pad";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("50, 60, 80, 120, 160",
                 "60, 70, 90, 130, 170",
                 "80, 90, 110, 150, 190",
                 "120, 130, 150, 190, 230",
                 "160, 170, 190, 230, 270");
        }
        cell_fall(io_template_5x5) {
          values("55, 65, 85, 125, 165",
                 "65, 75, 95, 135, 175",
                 "85, 95, 115, 155, 195",
                 "125, 135, 155, 195, 235",
                 "165, 175, 195, 235, 275");
        }
      }
    }

    /* Core-side output pin */
    pin(core_out) {
      direction : output;
      capacitance : 0.02;
      function : "enable ? core_out : 1'bz";
      timing() {
        related_pin : "pad";
        timing_sense : positive_unate;
        cell_rise(io_template_5x5) {
          values("60, 70, 90, 130, 170",
                 "70, 80, 100, 140, 180",
                 "90, 100, 120, 160, 200",
                 "130, 140, 160, 200, 240",
                 "170, 180, 200, 240, 280");
        }
        cell_fall(io_template_5x5) {
          values("65, 75, 95, 135, 175",
                 "75, 85, 105, 145, 185",
                 "95, 105, 125, 165, 205",
                 "135, 145, 165, 205, 245",
                 "175, 185, 205, 245, 285");
        }
      }
    }

    /* Power pins */
    pin(VDD) {
      direction : inout;
      use : power;
      voltage_name : "CORE";
    }
    pin(VSS) {
      direction : inout;
      use : ground;
      voltage_name : "CORE";
    }

    /* Power consumption */
    cell_leakage_power : 10.0;
    internal_power() {
      related_pin : "pad";
      rise_power(io_template_5x5) {
        values("0.1, 0.12, 0.15, 0.2, 0.25",
               "0.12, 0.14, 0.17, 0.22, 0.27",
               "0.15, 0.17, 0.2, 0.25, 0.3",
               "0.2, 0.22, 0.25, 0.3, 0.35",
               "0.25, 0.27, 0.3, 0.35, 0.4");
      }
      fall_power(io_template_5x5) {
        values("0.11, 0.13, 0.16, 0.21, 0.26",
               "0.13, 0.15, 0.18, 0.23, 0.28",
               "0.16, 0.18, 0.21, 0.26, 0.31",
               "0.21, 0.23, 0.26, 0.31, 0.36",
               "0.26, 0.28, 0.31, 0.36, 0.41");
      }
    }
  }
}
