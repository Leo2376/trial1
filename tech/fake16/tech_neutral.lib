  }





















  /* 5. Cellule SCAN D FLIP-FLOP (16 nm) */
cell(sdflop) {
  area : 1.5;
  ff("Q") {
    scan_data_in : "SI";
    scan_enable : "SE";
    clocked_on : "CLK";
    next_state : "D";
    clear : "none";
    preset : "none";
  }
  pin(D) {
    direction : input;
    capacitance : 0.005;
  }
  pin(SI) {
    direction : input;
    capacitance : 0.003;
  }
  pin(SE) {
    direction : input;
    capacitance : 0.002;
  }
  pin(CLK) {
    direction : input;
    capacitance : 0.003;
    timing() {
      timing_type : rising_edge;
      setup_rising(delay_template_5x5_16nm) {
        values("12, 17, 22, 27, 32",
               "17, 22, 27, 32, 37",
               "22, 27, 32, 37, 42",
               "27, 32, 37, 42, 47",
               "32, 37, 42, 47, 52");
      }
      hold_rising(delay_template_5x5_16nm) {
        values("3, 4, 5, 6, 7",
               "4, 5, 6, 7, 8",
               "5, 6, 7, 8, 9",
               "6, 7, 8, 9, 10",
               "7, 8, 9, 10, 11");
      }
    }
  }
  pin(Q) {
    direction : output;
    max_capacitance : 0.05;
    function : "(SE ? SI : D)";
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      cell_rise(delay_template_5x5_16nm) {
        values("15, 20, 25, 30, 35",
               "20, 25, 30, 35, 40",
               "25, 30, 35, 40, 45",
               "30, 35, 40, 45, 50",
               "35, 40, 45, 50, 55");
      }
    }
  }
}


  /* 6. Cellule FULL ADDER 2 bits (16 nm) */
  cell(fa2) {
    area : 2.0;
    pin(A) {
      direction : input;
      capacitance : 0.003;
    }
    pin(B) {
      direction : input;
      capacitance : 0.003;
    }
    pin(CIN) {
      direction : input;
      capacitance : 0.002;
    }
    pin(SUM) {
      direction : output;
      max_capacitance : 0.03;
      function : "A ^ B ^ CIN";
      timing() {
        related_pin : "A";
        cell_rise(delay_template_5x5_16nm) {
          values("8, 12, 16, 20, 24",
                 "12, 16, 20, 24, 28",
                 "16, 20, 24, 28, 32",
                 "20, 24, 28, 32, 36",
                 "24, 28, 32, 36, 40");
        }
      }
    }
    pin(COUT) {
      direction : output;
      max_capacitance : 0.03;
      function : "(A & B) | (A & CIN) | (B & CIN)";
    }
  }

  /* 7. Cellule MUX2 (16 nm) */
  cell(mux2) {
    area : 0.8;
    pin(D0) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D1) {
      direction : input;
      capacitance : 0.002;
    }
    pin(S) {
      direction : input;
      capacitance : 0.001;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.02;
      function : "(S & D1) | (!S & D0)";
      timing() {
        related_pin : "S";
        cell_rise(delay_template_5x5_16nm) {
          values("6, 9, 12, 15, 18",
                 "9, 12, 15, 18, 21",
                 "12, 15, 18, 21, 24",
                 "15, 18, 21, 24, 27",
                 "18, 21, 24, 27, 30");
        }
      }
    }
  }

  /* 8. Cellule MUX3 (16 nm) */
  cell(mux3) {
    area : 1.2;
    pin(D0) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D1) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D2) {
      direction : input;
      capacitance : 0.002;
    }
    pin(S0) {
      direction : input;
      capacitance : 0.001;
    }
    pin(S1) {
      direction : input;
      capacitance : 0.001;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.03;
      function : "(!S1 & !S0 & D0) | (!S1 & S0 & D1) | (S1 & D2)";
    }
  }

  /* 9. Cellule MUX4 (16 nm) */
  cell(mux4) {
    area : 1.6;
    pin(D0) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D1) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D2) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D3) {
      direction : input;
      capacitance : 0.002;
    }
    pin(S0) {
      direction : input;
      capacitance : 0.001;
    }
    pin(S1) {
      direction : input;
      capacitance : 0.001;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.04;
      function : "(!S1 & !S0 & D0) | (!S1 & S0 & D1) | (S1 & !S0 & D2) | (S1 & S0 & D3)";
    }
  }

  /* 10. Cellule XOR (16 nm) */
  cell(xor2) {
    area : 0.6;
    pin(A) {
      direction : input;
      capacitance : 0.002;
    }
    pin(B) {
      direction : input;
      capacitance : 0.002;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.02;
      function : "A ^ B";
      timing() {
        related_pin : "A";
        cell_rise(delay_template_5x5_16nm) {
          values("7, 10, 13, 16, 19",
                 "10, 13, 16, 19, 22",
                 "13, 16, 19, 22, 25",
                 "16, 19, 22, 25, 28",
                 "19, 22, 25, 28, 31");
        }
      }
    }
  }

  /* 11. Cellule NAND3 (16 nm) */
  cell(nand3) {
    area : 0.4;
    pin(A) {
      direction : input;
      capacitance : 0.002;
    }
    pin(B) {
      direction : input;
      capacitance : 0.002;
    }
    pin(C) {
      direction : input;
      capacitance : 0.002;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.03;
      function : "!(A & B & C)";
    }
  }

  /* 12. Cellule NAND4 (16 nm) */
  cell(nand4) {
    area : 0.5;
    pin(A) {
      direction : input;
      capacitance : 0.002;
    }
    pin(B) {
      direction : input;
      capacitance : 0.002;
    }
    pin(C) {
      direction : input;
      capacitance : 0.002;
    }
    pin(D) {
      direction : input;
      capacitance : 0.002;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.04;
      function : "!(A & B & C & D)";
    }
  }

  /* 13. Cellule OR2 (16 nm) */
  cell(or2) {
    area : 0.3;
    pin(A) {
      direction : input;
      capacitance : 0.002;
    }
    pin(B) {
      direction : input;
      capacitance : 0.002;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 0.02;
      function : "A | B";
    }
  }

  /* 14. Cellule OR3 (16 nm) */
  cell(or3) {
    area : 0.4;
    pin(A) {
      direction : input;
      capacitance : 0.002;
    }
    pin(B) {
      direction : input;
      capacitance : 0.002;
    }
    pin(C) {
      direction : input;
