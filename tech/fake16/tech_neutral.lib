    }
  }

  /* 15. Cellule CLOCK GATING (16 nm) */
  cell(icg) {
    area : 0.8;
    pin(CLK) {
      direction : input;
      capacitance : 0.003;
    }
    pin(EN) {
      direction : input;
      capacitance : 0.002;
    }
    pin(Q) {
      direction : output;
      max_capacitance : 0.03;
      function : "EN ? CLK : 0";
      timing() {
        related_pin : "EN";
        cell_rise(delay_template_5x5_16nm) {
          values("5, 8, 11, 14, 17",
                 "8, 11, 14, 17, 20",
                 "11, 14, 17, 20, 23",
                 "14, 17, 20, 23, 26",
                 "17, 20, 23, 26, 29");
        }
      }
    }
  }
}
